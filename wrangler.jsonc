{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true,
  },
  // Defaults for every site. Put your own settings (database id, routes, name, logo) in
  // wrangler.site.jsonc, which `npm run deploy` merges over this file; see README.
  //
  // The Worker serves the admin only, on a hostname behind Cloudflare Access. Add it in
  // wrangler.site.jsonc, e.g.
  //   "routes": [{ "pattern": "admin.status.example.com", "custom_domain": true }]
  // No other hostname should reach the Worker.
  "workers_dev": false,
  "preview_urls": false,
  // wrangler dev would otherwise present requests as if to the first route's host
  // (your admin address), and the local admin only works on localhost.
  "dev": {
    "host": "localhost",
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-status",
      "migrations_dir": "migrations",
    },
  ],
  // The public site: static files, served from the bucket on its own public hostname.
  "r2_buckets": [
    {
      "binding": "SITE",
      "bucket_name": "simple-status-site",
    },
  ],
  // Publishes leftover pages and the start or end of scheduled maintenance.
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Its id tells the cron job when a new version is deployed, to re-render the site.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    // Shown at the top of the public pages, in titles and in the feed.
    "SITE_NAME": "Status",
    // Optional: a logo shown before the name, as a file under public/, e.g.
    // "site/logo.svg" (public/site/ stays out of the repository), and a version for
    // dark mode. Both are copied to the site.
    "SITE_LOGO": "",
    "SITE_LOGO_DARK": "",
    // Filled in by npm run site-config from the files, as "200x40"; leave them empty.
    "SITE_LOGO_SIZE": "",
    "SITE_LOGO_DARK_SIZE": "",
    // The public site's URL, for absolute links in the Atom feed, e.g.
    // "https://status.example.com". Optional.
    "SITE_URL": "",
  },
  // Set with `wrangler secret put` (or in .dev.vars locally). See README.
  "secrets": {
    "required": ["ACCESS_TEAM_DOMAIN", "ACCESS_AUD"],
  },
}
