{
  "name": "simple-status",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "demo:setup": "wrangler d1 migrations apply DB --local --persist-to .wrangler/demo && wrangler d1 execute DB --local --persist-to .wrangler/demo --file=fixtures/demo.sql",
    "demo": "wrangler dev --persist-to .wrangler/demo",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "markdown-it": "^15.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
