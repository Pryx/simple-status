{
  "name": "simple-status (Claude Code sandbox)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Etc/UTC}",
      "CLAUDE_CODE_VERSION": "latest"
    }
  },
  // Needed by init-firewall.sh to configure iptables inside the container.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // Only named volumes: no host credentials (~/.ssh, ~/.claude, ~/.config,
  // cloud tokens) and no Docker socket are mounted into the sandbox.
  "mounts": [
    "source=simple-status-history-${devcontainerId},target=/commandhistory,type=volume",
    "source=simple-status-claude-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "WRANGLER_SEND_METRICS": "false",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "forwardPorts": [8787],
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
